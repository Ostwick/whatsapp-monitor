FROM node:18-slim

# Set ENV variables to use system Chromium and prevent downloads
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Create the non-root user for security
RUN groupadd -r appuser && useradd --no-log-init -r -g appuser -m -s /bin/false appuser

# Install system dependencies, including gosu and chromium
RUN apt-get update && apt-get install -y \
    gosu \
    chromium \
    # All the other lib dependencies for chromium...
    wget \
    ca-certificates \
    fonts-liberation \
    libappindicator3-1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libgdk-pixbuf2.0-0 \
    libnspr4 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    xdg-utils \
    libgbm-dev \
    libgtk-3-0 \
    libxshmfence-dev \
    libgconf-2-4 \
    libglib2.0-0 \
    --no-install-recommends \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Set the working directory and fix its ownership
WORKDIR /app
RUN chown -R appuser:appuser /app

# Switch to the non-root user for npm operations
USER appuser

# Copy package files and install dependencies as the non-root user
COPY --chown=appuser:appuser package*.json ./
RUN npm install

# Copy only the services directory, which contains whatsappService.js
COPY --chown=appuser:appuser services/ ./services/

# Switch back to root to set up the entrypoint script
USER root

# Copy the startup script and make it executable
COPY start.sh /usr/local/bin/start.sh
RUN chmod +x /usr/local/bin/start.sh

# Use an ENTRYPOINT to run the setup script
ENTRYPOINT ["/usr/local/bin/start.sh"]

# The default command to run after the entrypoint script
# This will be executed as the 'appuser'
CMD ["node", "services/whatsappService.js"]
