# Dockerfile.whatsapp
FROM node:18-slim
WORKDIR /app

# Instala libs do Chromium...
RUN apt-get update && apt-get install -y \
    wget ca-certificates fonts-liberation libappindicator3-1 \
    libasound2 libatk-bridge2.0-0 libatk1.0-0 libcups2 \
    libdbus-1-3 libgdk-pixbuf2.0-0 libnspr4 libnss3 \
    libx11-xcb1 libxcomposite1 libxdamage1 libxrandr2 \
    xdg-utils libgbm-dev libgtk-3-0 libxshmfence-dev \
    libgconf-2-4 libglib2.0-0 --no-install-recommends \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

# 1) Copia o único package.json da raiz
COPY package*.json ./

# 2) Instala deps de produção
RUN npm ci --omit=dev

# 3) Copia todo o resto (services/, electron/, etc)
COPY . .

CMD ["node", "services/whatsappService.js"]
