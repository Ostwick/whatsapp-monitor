FROM node:18-slim

# Create app user for security
RUN groupadd -r appuser && useradd -r -g appuser -s /bin/false appuser

WORKDIR /app

# Install Chromium and required dependencies
RUN apt-get update && apt-get install -y \
    chromium \
    wget \
    ca-certificates \
    fonts-liberation \
    libappindicator3-1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libgdk-pixbuf2.0-0 \
    libnspr4 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    xdg-utils \
    libgbm-dev \
    libgtk-3-0 \
    libxshmfence-dev \
    libgconf-2-4 \
    libglib2.0-0 \
    procps \
    psmisc \
    dbus-x11 \
    xvfb \
    --no-install-recommends && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Create symbolic link for chromium
RUN ln -s /usr/bin/chromium /usr/bin/chromium-browser

# Create necessary directories with proper permissions
RUN mkdir -p /tmp/chrome-${USER_ID} && \
    chown -R appuser:appuser /tmp/chrome-* && \
    chown -R appuser:appuser .wwebjs_auth

# Copy package files and install dependencies
COPY --chown=appuser:appuser package*.json ./
RUN npm ci --only=production && npm cache clean --force

# Copy application code
COPY --chown=appuser:appuser . .

# Set environment variables for Chrome
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    DISPLAY=:99 \
    CHROME_DEVEL_SANDBOX=/usr/lib/chromium/chrome-sandbox \
    PUPPETEER_DISABLE_PROFILE_LOCK=true

# Create startup script to handle cleanup and initialization
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
# Function to cleanup on exit\n\
cleanup() {\n\
    echo "Cleaning up Chrome processes..."\n\
    pkill -f chromium || true\n\
    pkill -f chrome || true\n\
    find /tmp -name "chrome-*" -type d -exec rm -rf {} + 2>/dev/null || true\n\
    exit 0\n\
}\n\
\n\
# Set trap for cleanup\n\
trap cleanup SIGTERM SIGINT\n\
\n\
# Clean up any existing Chrome processes and locks\n\
echo "Initial cleanup..."\n\
pkill -f chromium || true\n\
pkill -f chrome || true\n\
\n\
# Clean Chrome temp directories (only ones we can access)\n\
find /tmp -name "chrome-*" -type d -user appuser -exec rm -rf {} + 2>/dev/null || true\n\
\n\
# Clean session locks (only if we have permission)\n\
find /app/.wwebjs_auth -name "SingletonLock" -exec rm -f {} + 2>/dev/null || true\n\
find /app/.wwebjs_auth -name "SingletonSocket" -exec rm -f {} + 2>/dev/null || true\n\
find /app/.wwebjs_auth -name "SingletonCookie" -exec rm -f {} + 2>/dev/null || true\n\
find /app/.wwebjs_auth -name "Default" -type d -exec rm -rf {} + 2>/dev/null || true\n\
\n\
# Create temp directory for this instance\n\
mkdir -p /tmp/chrome-${USER_ID:-default} || true\n\
\n\
# Start the application\n\
echo "Starting WhatsApp service for ${USER_ID:-default}..."\n\
exec node services/whatsappService.js "$@"\n\
' > /app/start.sh && chmod +x /app/start.sh

# Switch to non-root user
USER appuser

# Health check
HEALTHCHECK --interval=60s --timeout=10s --start-period=60s --retries=3 \
    CMD node -e "process.exit(process.memoryUsage().heapUsed > 280000000 ? 1 : 0)" || exit 1

# Use startup script
CMD ["/app/start.sh"]
