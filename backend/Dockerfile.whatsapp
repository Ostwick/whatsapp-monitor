FROM node:18-slim

# Install Chromium and minimal dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libgbm1 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxshmfence1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Puppeteer config
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV CHROMIUM_FLAGS="--no-sandbox --disable-dev-shm-usage --single-process"

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies
RUN if [ -f package-lock.json ]; then npm ci --omit=dev; else npm install --omit=dev; fi

# Copy app files
COPY . .

# Create non-root user
RUN useradd -r -u 1001 -g root appuser && \
    chown -R appuser:root /app
USER appuser

HEALTHCHECK --interval=30s --timeout=5s \
    CMD node -e "process.exit(process.memoryUsage().heapUsed > 280000000 ? 1 : 0)"

CMD ["node", "src/index.js"]  # Adjust to your entry point
