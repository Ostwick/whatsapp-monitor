FROM node:18-alpine

WORKDIR /app

# Copy package files from ROOT directory
COPY package.json .
COPY package-lock.json .

# Install dependencies
RUN npm install --omit=dev

# Copy backend-specific files
COPY . .

# Create non-root user
RUN adduser -D appuser && \
    chown -R appuser:appuser /app
USER appuser

EXPOSE 3000

CMD ["node", "api.js"]
